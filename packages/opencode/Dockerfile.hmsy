FROM debian:trixie AS base

# Disable the runtime transpiler cache by default inside Docker containers.
# On ephemeral containers, the cache is not useful
ARG BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=${BUN_RUNTIME_TRANSPILER_CACHE_PATH}

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    ripgrep \
  && rm -rf /var/lib/apt/lists/*

FROM base AS full
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    curl \
    python3 \
    python3-pip \
    nodejs \
    npm \
  && rm -rf /var/lib/apt/lists/* \
  && curl -sL https://gitlab.com/gitlab-org/cli/-/releases/permalink/latest/downloads/glab_$(dpkg --print-architecture).deb -o /tmp/glab.deb \
  && apt-get install -y /tmp/glab.deb \
  && rm /tmp/glab.deb

FROM base AS build-amd64
COPY dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode

FROM base AS build-arm64
COPY dist/opencode-linux-arm64/bin/opencode /usr/local/bin/opencode

FROM base AS build-full-amd64
COPY dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode

FROM base AS build-full-arm64
COPY dist/opencode-linux-arm64/bin/opencode /usr/local/bin/opencode

# Slim variant (default)
ARG TARGETARCH
FROM build-${TARGETARCH} AS slim
RUN chmod +x /usr/local/bin/opencode && opencode --version
ENTRYPOINT ["opencode"]

# Full variant
FROM build-full-${TARGETARCH} AS full-final
RUN chmod +x /usr/local/bin/opencode && opencode --version
ENTRYPOINT ["opencode"]
